@article{Brunner1977,
	title = {A definition of coordination and its relevance in the structure types {AlB}{\textbackslash}sb 2 and {NiAs}},
	volume = {33},
	url = {https://doi.org/10.1107/S0567739477000461},
	doi = {10.1107/S0567739477000461},
	abstract = {The largest gap in the list of reciprocal interatomic distances is used to limit the coordination polyhedra. For the structure types AIB{\textbackslash}sb 2 and NiAs, the polyhedra are evaluated according to ıt c/ıt a. In plots of ıt c/ıt a ıt versus ıt r{\textbackslash}sb A/ıt r{\textbackslash}sb B, the various coordination types correspond to actually observed families of representatives. These results as well as others from more than 50 structure types support the view that coordination as limited by the largest gap is a realistic factor.},
	number = {1},
	journal = {Acta Crystallographica Section A},
	author = {Brunner, G. O.},
	month = jan,
	year = {1977},
	pages = {226--227},
}

